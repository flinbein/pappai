#!/usr/bin/python3 -I
"""POSIX client for the authenticated RPC endpoint of a pappai terminal."""
import json
import os
import select
import socket
import struct
import sys
import termios
import tty


USAGE = """Usage: pappai [OPTIONS] COMMAND
  -u, --as NODE_ID           Select a local administrator RPC identity
  -r, --restrict-to NODE_ID  Add a permission subject (repeatable; also --restrict)
      --permissions JSON     Intersect with an inline list of permit rules
      --with-rpc             Give a run child access to the narrowed RPC socket

  pappai me
  pappai checkPermissions JSON
  pappai call NODE METHOD [JSON]
  pappai help [--schema] [--doc] NODE [FEATURE]
  pappai discover [JSON]
  pappai emit EVENT [JSON]
  pappai cli NODE METHOD [JSON]
  pappai cli NODE METHOD -- [ARG ...]
  pappai [OPTIONS] run PROGRAM [ARG ...]"""


def request(args):
    if not args or args[0] in ('--help', '-h'):
        print(USAGE)
        sys.exit(0)
    op, *args = args
    if op == 'me' and not args:
        return op, {}
    if op == 'checkPermissions' and len(args) == 1:
        return op, json.loads(args[0])
    if op == 'run' and args:
        return op, {'argv': args, 'cwd': os.getcwd(),
                    'tty': all(os.isatty(fd) for fd in (0, 1, 2)),
                    'env': {key: os.environ[key] for key in
                            ('TERM', 'LANG', 'LC_ALL', 'LC_CTYPE', 'COLORTERM') if key in os.environ}}
    if op == 'cli' and len(args) >= 3 and args[2] == '--':
        return op, {'node': args[0], 'method': args[1], 'input': {'args': args[3:]}}
    if op in ('call', 'cli') and len(args) in (2, 3):
        data = json.loads(args[2]) if len(args) == 3 else {}
        return op, {'node': args[0], 'method': args[1], 'input' if op == 'cli' else 'data': data}
    if op == 'help':
        options = {}
        while args and args[0] in ('--doc', '--schema'):
            options[args.pop(0)[2:]] = True
        if len(args) in (1, 2):
            if len(args) == 2:
                options['features'] = args[1]
            elif options:
                options['features'] = True
            return op, {'node': args[0], **options}
    if op == 'discover' and len(args) <= 1:
        return op, json.loads(args[0]) if args else {}
    if op == 'emit' and len(args) in (1, 2):
        return 'publish', {'event': args[0], 'data': json.loads(args[1]) if len(args) == 2 else {}}
    raise ValueError(USAGE)


def receive(sock, size):
    data = bytearray()
    while len(data) < size:
        part = sock.recv(size - len(data))
        if not part:
            raise ValueError('Terminal connection closed')
        data.extend(part)
    return data


def frame(sock):
    kind, size = struct.unpack('!BI', receive(sock, 5))
    if size > 16 * 1024 * 1024 or kind not in (0, 1, 2):
        raise ValueError('Invalid terminal response')
    data = receive(sock, size)
    if kind:
        return kind, data
    status = json.loads(data)
    if 'error' in status:
        raise ValueError(status['error'])
    return kind, status


def geometry():
    try:
        size = os.get_terminal_size()
        return min(1000, max(1, size.columns)), min(1000, max(1, size.lines))
    except OSError:
        return 80, 24


def relay(sock, size, interactive):
    kind, started = frame(sock)
    if kind or not started.get('started'):
        raise ValueError('Terminal command did not start')
    previous = termios.tcgetattr(0) if interactive and os.isatty(0) else None
    stdin_open = True
    outbound = bytearray()
    try:
        if previous is not None:
            tty.setraw(0, termios.TCSANOW)
        while True:
            inputs = [sock, 0] if stdin_open and not outbound else [sock]
            ready, writable, _ = select.select(inputs, [sock] if outbound else [], [], 0.2)
            current = geometry() if interactive else size
            if current != size and not outbound:
                cols, rows = size = current
                outbound.extend(struct.pack('!BIHH', 2, 4, rows, cols))
            if sock in ready:
                kind, data = frame(sock)
                if kind == 0:
                    code = data['exitCode']
                    return code if code >= 0 else 128 - code
                stream = sys.stdout.buffer if kind == 1 else sys.stderr.buffer
                stream.write(data)
                stream.flush()
            if 0 in ready:
                data = os.read(0, 16384)
                kind = 1
                if not data:
                    stdin_open = False
                    if interactive:
                        data = b'\x04'
                    else:
                        kind = 3
                outbound.extend(struct.pack('!BI', kind, len(data)) + data)
            if sock in writable:
                try:
                    sent = sock.send(outbound, socket.MSG_DONTWAIT)
                except BlockingIOError:
                    continue
                del outbound[:sent]
    finally:
        if previous is not None:
            termios.tcsetattr(0, termios.TCSANOW, previous)


def main():
    args = sys.argv[1:]
    options = {}
    with_rpc = False
    while args and args[0] in ('-u', '--as', '-r', '--restrict', '--restrict-to', '--permissions', '--with-rpc'):
        flag = args.pop(0)
        if flag == '--with-rpc':
            with_rpc = True
            continue
        if not args:
            raise ValueError('Missing value for ' + flag)
        value = args.pop(0)
        if flag in ('-r', '--restrict', '--restrict-to'):
            options.setdefault('restrictPermissions', []).append(value)
        else:
            key = 'permissions' if flag == '--permissions' else 'asNode'
            if key in options:
                raise ValueError('Repeated option ' + flag)
            options[key] = json.loads(value) if key == 'permissions' else value
    if (options or with_rpc) and not args:
        raise ValueError('Expected a command')
    method, params = request(args)
    if method == 'run':
        params['withRpc'] = with_rpc
    elif with_rpc:
        raise ValueError('--with-rpc applies only to run')
    terminal = '/run/pappai/terminal.sock'
    path = terminal if os.path.exists(terminal) else '/run/pappai-admin/rpc.sock'
    cols, rows = size = geometry()
    message = json.dumps({'method': method, 'params': params, **options, 'cols': cols, 'rows': rows}).encode()
    if len(message) > 65536:
        raise ValueError('Terminal request is too large')
    with socket.socket(socket.AF_UNIX) as sock:
        try:
            sock.connect(path)
        except FileNotFoundError:
            raise ValueError('pappai RPC is unavailable in this process') from None
        sock.sendall(struct.pack('!I', len(message)) + message)
        if method in ('cli', 'run'):
            return relay(sock, size, method == 'cli' or params['tty'])
        kind, status = frame(sock)
        if kind:
            raise ValueError('Expected a terminal RPC result')
        print(json.dumps(status['result'], ensure_ascii=False))
        return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, KeyError) as error:
        print('pappai:', error, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
